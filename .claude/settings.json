{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
                "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/harness/hooks/guard-edits.mjs" }]
            }
        ],
        "Stop": [
            {
                "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/harness/hooks/stop-check.sh", "timeout": 900 }]
            }
        ]
    }
}
