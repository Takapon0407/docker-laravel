APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB を使わない構成のため、キャッシュ・セッションはファイル、キューは同期実行
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
# 本番（HTTPS）では true にして、セッション Cookie に Secure 属性を付ける
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# 写真（/hobbies）の取得元 S3
# 本番は EC2 の IAM ロールを使うためキーは空のまま。ローカルは開発用 IAM ユーザーのキーを設定する
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=photographs-qa

# 匿名質問ボード（/tools/board）。公開するまでは false。ローカルでは dev 環境の WebSocket の URL を指定する
BOARD_ENABLED=false
BOARD_WEBSOCKET_URL=
