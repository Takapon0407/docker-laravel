# 秘密情報・不要物をイメージに含めない
.git
.github
.claude
security-audit
docker/db
laravel/.env
laravel/.env.*
laravel/node_modules
# 前回のキャッシュ（APP_KEY を含む設定キャッシュ）やログをイメージに含めない（storage は実行時にマウント、設定キャッシュはコンテナごとに作る）
laravel/storage
laravel/bootstrap/cache
# ローカル開発用の設定は本番のイメージに含めない
docker-compose.override.yml
docker/php/php.local.ini
